{
	"name": "hole",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "vp check && prettier --check \"**/*.svelte\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint && prettier --check \"**/*.svelte\"",
		"format": "vp fmt . && prettier --write \"**/*.svelte\"",
		"gen": "wrangler types",
		"test:unit": "vp test run",
		"test": "vp run test:unit && vp run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@voidzero-dev/vite-plus-core": "^0.1.24",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"vite-plugin-devtools-json": "^1.1.2",
		"vite-plus": "^0.1.24",
		"vitest-browser-svelte": "^2.2.1",
		"wrangler": "~4.86.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"vite": "npm:@voidzero-dev/vite-plus-core@^0.1.14",
			"vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.14"
		}
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@drop-in/graffiti": "^4.30.0",
		"@instantdb/svelte": "^0.22.185"
	}
}
