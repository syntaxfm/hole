{
	"name": "hole",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "vp check && prettier --check \"**/*.svelte\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint && prettier --check \"**/*.svelte\"",
		"format": "vp fmt . && prettier --write \"**/*.svelte\"",
		"gen": "wrangler types",
		"test:unit": "vp test run",
		"test": "vp run test:unit && vp run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@voidzero-dev/vite-plus-core": "^0.1.14",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plus": "^0.1.14",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.63.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"vite": "npm:@voidzero-dev/vite-plus-core@^0.1.14",
			"vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.14"
		}
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@drop-in/graffiti": "^4.23.1",
		"@instantdb/svelte": "^0.22.169"
	}
}
